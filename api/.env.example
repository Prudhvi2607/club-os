# Database (Neon — get both strings from neon.tech dashboard → Connection Details → Prisma)
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DIRECT_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# Auth
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Email (Gmail SMTP)
EMAIL_USER=yourclub@gmail.com
EMAIL_PASS=your-gmail-app-password
CLUB_NAME=My Cricket Club

# CORS
CORS_ORIGIN=http://localhost:3000

# Seed (run once with: npm run seed)
SEED_CLUB_NAME=My Cricket Club
SEED_CLUB_SLUG=my-cricket-club
SEED_CLUB_SPORT=Cricket
SEED_ADMIN_EMAIL=you@example.com
SEED_ADMIN_NAME=Your Name
